From 4e162bc51590e8154020bdf67c3b7c1427aed3bb Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=D0=A1=D1=83=D1=85=D0=B0=D1=80=D0=B8=D0=BA?=
 <65870+suhr@users.noreply.github.com>
Date: Wed, 30 Jul 2025 00:37:31 +0000
Subject: Patch for Haiku


diff --git a/src/bin/lean.in b/src/bin/lean.in
index 044b4ce..1e91391 100755
--- a/src/bin/lean.in
+++ b/src/bin/lean.in
@@ -1,4 +1,4 @@
-#!/usr/bin/env bash
+#!/bin/bash
 # ONLY FOR WEB ASSEMBLY BUILD
 node --stack-size=8192 ${CMAKE_BINARY_DIR}/bin/lean.js $@
 
diff --git a/src/bin/leanc.in b/src/bin/leanc.in
index 3307553..38b491c 100755
--- a/src/bin/leanc.in
+++ b/src/bin/leanc.in
@@ -1,4 +1,4 @@
-#!/usr/bin/env bash
+#!/bin/bash
 # used only for building Lean itself
 root=$(dirname $0)
 ldflags=(@LEANC_INTERNAL_LINKER_FLAGS@ "-L$root/lib/lean" @LEAN_EXTRA_LINKER_FLAGS@)
diff --git a/src/bin/leanmake b/src/bin/leanmake
index 7a04a26..e326d44 100755
--- a/src/bin/leanmake
+++ b/src/bin/leanmake
@@ -1,4 +1,4 @@
-#!/usr/bin/env bash
+#!/bin/bash
 # A simple wrapper around `make` and the `lean.mk` makefile
 # When called from a directory containing a `Makefile` file, calls `make` with
 # the directory containing `lean.mk` in its path so that you can use
diff --git a/src/cmake/run_checker.sh b/src/cmake/run_checker.sh
index 98c5bbf..17f2422 100644
--- a/src/cmake/run_checker.sh
+++ b/src/cmake/run_checker.sh
@@ -1,4 +1,4 @@
-#!/usr/bin/env bash
+#!/bin/bash
 emulator=$1
 lean_bin=$2
 leanchecker_bin=$3
diff --git a/src/lean.mk.in b/src/lean.mk.in
index 4c979f1..5766b60 100644
--- a/src/lean.mk.in
+++ b/src/lean.mk.in
@@ -44,7 +44,7 @@ NAT_OBJS = $(patsubst %.lean,$(TEMP_OUT)/%.o,$(shell find $(PKG) $(PKG).lean -na
 ALL_NAT_OBJS = $(patsubst %.lean,$(TEMP_OUT)/%.o,$(SRCS))
 endif
 
-SHELL = /usr/bin/env bash -euo pipefail
+SHELL = /bin/bash -euo pipefail
 
 .PHONY: all bin lib depends clean
 # Disable all default make rules
@@ -123,7 +123,7 @@ endif
 	$(LEANC) -c -o $@ $< $(LEANC_OPTS)
 else
 $(TEMP_OUT)/%.o: $(TEMP_OUT)/%.o.export
-	ln -f $< $@
+	cp $< $@
 endif
 
 $(BIN_OUT)/$(BIN_NAME): $(LIB_OUT)/$(STATIC_LIB_NAME).export | $(BIN_OUT)
@@ -154,7 +154,7 @@ $(LIB_OUT)/$(STATIC_LIB_NAME): $(NAT_OBJS) | $(LIB_OUT)
 # no response file support on macOS, but also no need for them
 	@$(LEAN_AR) rcs $@ $^
 $(LIB_OUT)/$(STATIC_LIB_NAME).export: $(LIB_OUT)/$(STATIC_LIB_NAME)
-	ln -f $< $@
+	cp $< $@
 endif
 
 clean:
diff --git a/src/stdlib.make.in b/src/stdlib.make.in
index c015fdf..b92303c 100644
--- a/src/stdlib.make.in
+++ b/src/stdlib.make.in
@@ -1,7 +1,7 @@
 # LEAN_BASH: Makes the Bash shell used by the Lean build configurable.
 # On Windows, when CMake/Make is spawned directly (e.g., VSCode's CMake Tools),
 # it lacks a proper shell environment, so we need to manually point it to Bash.
-LEAN_BASH ?= /usr/bin/env bash
+LEAN_BASH ?= /bin/bash
 SHELL := $(LEAN_BASH) -eo pipefail
 
 # any absolute path to the stdlib breaks the Makefile
